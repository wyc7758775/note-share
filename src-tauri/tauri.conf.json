{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteShare",
  "version": "0.4.0",
  "identifier": "com.yoran.noteshare",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5188",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoteShare 笔记",
        "width": 1280,
        "height": 820,
        "minWidth": 560,
        "minHeight": 420,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4RjVCREFBMEMzNTExMjIKUldRaUVUVU1xcjMxK0VQNkZBcUpHZE9tYWxCNnE0dlJqa3VqUm5tZjhmQlpJWUlUUVBnZnB6UFYK",
      "endpoints": [
        "https://github.com/wyc7758775/note-share/releases/latest/download/latest.json"
      ]
    }
  }
}
