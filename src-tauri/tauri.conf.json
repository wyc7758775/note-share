{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteShare",
  "version": "0.1.0",
  "identifier": "com.yoran.noteshare",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5188",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoteShare 笔记",
        "width": 1280,
        "height": 820,
        "minWidth": 560,
        "minHeight": 420,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
